{
  "manifest_version": 3,
  "name": "LSC AI Auto Filler",
  "version": "0.1.0",
  "description": "Local-first AI assistant for job application forms.",
  "action": {
    "default_title": "LSC AI Auto Filler"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1:4317/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
