{
  "name": "@lsc-ai/extension",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsup --config tsup.config.ts && cp manifest.json dist/manifest.json && cp popup.html dist/popup.html",
    "dev": "tsup --config tsup.config.ts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lsc-ai/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.320",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
